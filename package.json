{
  "name": "pebble-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared packages for Pebble product repos",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "changeset": "changeset",
    "release": "pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@pebbletech/config": "workspace:*",
    "@types/node": "catalog:",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt"
    ],
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint"
  }
}
